{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kznagamori/go_dev_tool_version_manager/schemas/registry/v1",
  "title": "gdtvm registry manifest schema 1",
  "description": "docs/07-registry-and-tools.md §3 の registry.toml を機械可読にした補助成果物である。正本は同§であり、実装の正本は internal/registry の strict parser である。本fileは構造だけを表し、client versionの範囲照合、definition fileのdigest照合、§2のexact tree検査は表現しない。",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "tool_definition_schema", "client_min_version", "tools"],
  "properties": {
    "schema": {
      "description": "manifest自身のschema版。schema 1だけを扱う。",
      "type": "integer",
      "const": 1
    },
    "tool_definition_schema": {
      "description": "収める tool definition のschema版。",
      "type": "integer",
      "const": 1
    },
    "client_min_version": {
      "description": "このregistryを読める最小client version（CalVer YYYY.MM.DD.XX）。",
      "$ref": "#/$defs/clientVersion"
    },
    "client_max_version": {
      "description": "上限。§3で唯一の任意keyである。",
      "$ref": "#/$defs/clientVersion"
    },
    "tools": {
      "description": "ID ASCII byte順のexactly 4件。ID一意。",
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": { "$ref": "#/$defs/toolEntry" }
    }
  },
  "$defs": {
    "clientVersion": {
      "type": "string",
      "pattern": "^[0-9]{4}[.](0[1-9]|1[0-2])[.](0[1-9]|[12][0-9]|3[01])[.][0-9]{2}$"
    },
    "toolEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path", "sha256"],
      "properties": {
        "id": {
          "description": "tool ID。file basenameと一致する（06-tool-definition.md §3）。",
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
          "maxLength": 64
        },
        "path": {
          "description": "registry rootからの相対path。`tools/<id>.toml`固定。",
          "type": "string",
          "pattern": "^tools/[a-z][a-z0-9]*(?:-[a-z0-9]+)*[.]toml$"
        },
        "sha256": {
          "description": "definition fileのraw bytesのdigest。gdtvm自身が計算する内部SHA-256で、upstream digestと違いalgorithm prefixを持たない。",
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  }
}
